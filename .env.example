# Casa de Nabais — Variáveis de Ambiente
#
# Para desenvolvimento local:
#   cp .env.example .env.local
#   Preenche com os valores reais
#
# Para produção:
#   Adiciona estas variáveis no Vercel (Settings > Environment Variables)

# URL do Google Apps Script Web App — leads "Ficar na Casa"
# Como obter: scripts/google-apps-script.gs → Deploy → copia o URL
NEXT_PUBLIC_APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# URL do Google Apps Script Web App — leads "Comprar Vinho"
# Como obter: scripts/google-apps-script-vinhos.gs → Deploy → copia o URL
# Nota: variável server-side (sem NEXT_PUBLIC_), não precisa de redeploy de build
APPS_SCRIPT_URL_VINHOS=https://script.google.com/macros/s/YYYYYYYY/exec
